+
+// Turn 1 publishes E@turn1 (consumed by turn 2); turn 2 publishes R@input and E@end.
+// The adopt-time demand record therefore sits at turn1, a position with no checkpoint.
+Dialogue continued_once(Fixture& f, std::uint32_t turn1, std::uint32_t input, std::uint32_t end,
+                        std::uint32_t first, std::uint32_t replay_pages = 1) {
+    const auto predecessor = f.program.add(tokens(turn1, first), {}, Role::Continuation);
+    const auto owner       = f.publish(predecessor);
+    const Base next{.tokens = tokens(end, first)};
+    auto choice = f.source(next, predecessor);
+    require(choice.take_over && choice.source.consume_source, "turn 2 did not take over turn 1");
+    require(f.program.release_checkpoint(predecessor), "fixture consume failed");
+    require(f.cache.adopt(f.program, choice, next, ++f.next_order, {}, {&predecessor, 1}) == owner,
+            "turn 2 did not continue its owner");
+    const auto replay   = f.program.add(tokens(input, first), {}, Role::InputReplay);
+    const auto endpoint = f.program.add(tokens(end, first), {}, Role::Continuation);
+    f.program.contents[replay.index].main_pages     = replay_pages;
+    f.program.contents[replay.index].demotion_bytes = 32;
+    f.cache.publish(f.program, owner, replay);
+    f.cache.publish(f.program, owner, endpoint);
+    f.cache.finish(f.program, owner, next, f.next_order);
+    return {owner, replay, endpoint};
+}
