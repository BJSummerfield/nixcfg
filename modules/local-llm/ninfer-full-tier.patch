+// Replays the 2026-10-11 host-admit runs against the ResourceManager with a first-fit Host
+// arena of the live geometry. 1 fixture token = 1 main KV page = 64 real tokens.
+#define main original_test_main
+#include "test_resource_manager.cpp"
+#undef main
+
+#include <cstdlib>
+#include <string>
+#include <type_traits>
+
+namespace {
+
+constexpr std::size_t kImage       = 153'954'304;
+constexpr std::size_t kMainPage    = 2'113'536;
+constexpr std::size_t kMtpPage     = 132'096;
+constexpr std::size_t kCapacity    = 18'350'080'000;
+constexpr std::uint32_t kDevice    = 3653; // 233,792 / 64
+constexpr std::uint32_t kChunk     = 32;   // --prefill-chunk 2048 / 64
+constexpr std::uint32_t kFill      = 941;  // ~60,173 tokens
+constexpr std::uint32_t kTarget    = 469;  // ~29,988 tokens
+constexpr std::uint32_t kTargetAdd = 9;    // turn 2 adds ~530 tokens
+constexpr std::uint32_t kPush      = 1439; // ~92,062 tokens
+constexpr std::uint32_t kPushAdd   = 8;
+// One sweep point. Device images 0 is the faithful live setting: every new image went to the Host.
+struct Point {
+    std::uint32_t fill_delta    = 0;
+    std::uint32_t push_delta    = 0;
+    bool live_sizes             = false;
+    std::uint32_t device_images = 0;
+};
+Point g_point;
+
+// The same source builds against 81c8ce09, the deployed #239 patch and the fix.
+template <class Cache>
+auto counters_of(const Cache& cache) {
+    if constexpr (requires { cache.writeback_counters(); }) {
+        return cache.writeback_counters();
+    } else {
+        return 0;
+    }
+}
+
+using Progress = ninfer::runtime::ReclaimProgress;
+
+struct Convo {
+    Fixture::Token owner = 0;
+    std::uint32_t first  = 0;
+    std::uint32_t prompt = 0;          // pages of the latest turn's prompt
+    std::optional<Handle> replay;      // R@prompt, holds the KV pages
+    std::optional<Handle> endpoint;    // E@prompt+1, image only (the covered suffix)
+    bool reported = false;
+};
+
+struct Replay {
+    Fixture f{kCapacity};
+    std::uint32_t running    = 0;
+    std::uint32_t next_first = 1;
+    std::size_t skipped_captures = 0;
+    std::size_t blocked      = 0;
+    bool verbose             = std::getenv("REPLAY_VERBOSE") != nullptr;
+
+    Replay() {
+        f.program.contiguous     = true;
+        f.program.main_capacity  = kDevice;
+        f.program.state_capacity = 7;
+        f.program.trace_placement = verbose;
+    }
+
+    [[nodiscard]] std::uint32_t device_used() const {
+        std::uint32_t used = running;
+        for (const auto& content : f.program.contents) {
+            if (content.alive) { used += content.main_pages; }
+        }
+        return used;
+    }
+
+    [[nodiscard]] std::size_t host_used() const {
+        return f.program.physical_usage().occupied.host_bytes;
+    }
+
+    // Companion images die with their page holder, as the production holder group would.
+    void sweep(std::vector<Convo*> dialogues) {
+        for (auto* d : dialogues) {
+            if (d->replay && !f.program.valid_checkpoint(*d->replay) && !d->reported) {
+                d->reported = true;
+                if (verbose) {
+                    std::cout << "    LOST: dialogue first=" << d->first << " prompt=" << d->prompt
+                              << " (R#" << d->replay->index << ")\n";
+                }
+            }
+            if (d->replay && !f.program.valid_checkpoint(*d->replay) && d->endpoint &&
+                f.program.valid_checkpoint(*d->endpoint)) {
+                (void)f.cache.erase(f.program, *d->endpoint);
+            }
+        }
+    }
+
+    // One prefill chunk after another: the scheduler's reserve_units -> reclaim loop.
+    void need_device(std::uint32_t pages) {
+        for (std::uint32_t done = 0; done < pages;) {
+            const auto chunk = std::min(kChunk, pages - done);
+            int guard        = 0;
+            while (kDevice - device_used() < chunk) {
+                const auto shortage = chunk - (kDevice - device_used());
+                const auto progress =
+                    f.cache.reclaim(f.program, {.main_kv_pages = shortage});
+                if (progress == Progress::Blocked) {
+                    ++blocked;
+                    throw std::runtime_error("device reclaim blocked");
+                }
+                require(++guard < 100000, "reclaim did not converge");
+            }
+            running += chunk;
+            done += chunk;
+        }
+    }
+
+    [[nodiscard]] std::uint32_t device_images() const {
+        std::uint32_t used = 0;
+        for (const auto& content : f.program.contents) {
+            if (content.alive && content.device_state) { ++used; }
+        }
+        return used;
+    }
+
+    Handle publish_point(Fixture::Token token, const Base& base, std::uint32_t frontier,
+                         std::uint32_t pages, Role role, std::optional<std::size_t> block) {
+        const auto handle = f.program.add(*base.prefix_shortlist_key(frontier),
+                                          block ? std::vector<std::size_t>{*block}
+                                                : std::vector<std::size_t>{},
+                                          role);
+        auto& content          = f.program.contents[handle.index];
+        content.device_state   = !block;
+        content.main_pages     = pages;
+        content.demotion_bytes = kMainPage;
+        content.state_bytes    = kImage;
+        content.mtp_bytes      = kMtpPage;
+        f.cache.publish(f.program, token, handle);
+        return handle;
+    }
+
+    // prepare_semantic_capture: a free Device image slot, else a direct Host image write
+    // (victims by bytes), else reclaim one Device state slot and retry; otherwise the capture
+    // is skipped.
+    std::optional<Handle> capture(Fixture::Token token, const Base& base, std::uint32_t frontier,
+                                  std::uint32_t pages, Role role) {
+        const auto admission = f.cache.capture_admission(f.program, token, base, frontier, true);
+        auto cursor          = f.cache.begin_reclaim(f.program, admission);
+        for (int round = 0; round < 64; ++round) {
+            if (device_images() < g_point.device_images) {
+                return publish_point(token, base, frontier, pages, role, std::nullopt);
+            }
+            if (auto block = f.program.try_host_block(kImage)) {
+                return publish_point(token, base, frontier, pages, role, block);
+            }
+            // Engine-side part of the fix: an image write the arena cannot place asks for
+            // victims of its whole size (engine_core.h prepare_semantic_capture).
+            const bool unplaceable = !f.program.host_hole(kImage).has_value();
+            if (kCapacity - host_used() < kImage || unplaceable) {
+                const auto victims = [&](auto& cache) {
+                    using Rights = decltype(cursor.rights);
+                    if constexpr (requires { cache.host_victims(f.program, kImage, std::nullopt, std::span<const Handle>{}, std::span<const Handle>{}, admission, &cursor, Rights{}, true); }) {
+                        return cache.host_victims(f.program, kImage, std::nullopt, {}, {}, admission, &cursor, {}, unplaceable);
+                    } else {
+                        return cache.host_victims(f.program, kImage, std::nullopt, {}, {}, admission, &cursor);
+                    }
+                }(f.cache);
+                if (victims && !victims->empty()) {
+                    if (verbose) {
+                        std::cout << "    capture victims:";
+                        for (const auto v : *victims) {
+                            std::cout << " #" << v.index << "("
+                                      << f.program.contents[v.index].tokens.size() << ","
+                                      << f.program.host_bytes_released({&v, 1}) / 1e6 << "MB)";
+                        }
+                        std::cout << "\n";
+                    }
+                    f.cache.commit_host_victims(f.program, *victims, cursor);
+                    if (auto block = f.program.try_host_block(kImage)) {
+                        return publish_point(token, base, frontier, pages, role, block);
+                    }
+                }
+            }
+            const auto progress = f.cache.reclaim(f.program, {.state_slots = 1}, {}, cursor);
+            if (progress == Progress::Blocked) { break; }
+        }
+        ++skipped_captures;
+        if (verbose) {
+            std::cout << "    skipped capture frontier=" << frontier << " role="
+                      << static_cast<int>(role) << " free=" << (kCapacity - host_used()) / 1e6
+                      << "MB largest_hole=" << f.program.largest_hole() / 1e6 << "MB\n";
+        }
+        return std::nullopt;
+    }
+
+    Convo root(std::uint32_t prompt, const char* label) {
+        Convo d;
+        d.first = next_first;
+        next_first += 100000;
+        d.prompt = prompt;
+        const Base base{.tokens = tokens(prompt + 1, d.first)};
+        auto choice = f.source(base, std::nullopt);
+        d.owner     = f.cache.adopt(f.program, choice, base, ++f.next_order);
+        need_device(prompt);
+        d.replay = capture(d.owner, base, prompt, running, Role::InputReplay);
+        running  = 0;
+        d.endpoint = capture(d.owner, base, prompt + 1, 0, Role::Continuation);
+        f.cache.finish(f.program, d.owner, base, f.next_order);
+        note(label, d);
+        return d;
+    }
+
+    // Returns the pages the continuation found cached (0 = served as root).
+    std::uint32_t continue_turn(Convo& d, std::uint32_t added, const char* label) {
+        const auto prompt = d.prompt + added;
+        const Base base{.tokens = tokens(prompt + 1, d.first)};
+        std::uint32_t cached = 0;
+        auto choices         = f.cache.candidates(f.program, base, UINT32_MAX);
+        require(!choices.empty(), "no candidates");
+        auto& choice = choices.front();
+        if (choice.source.checkpoint) {
+            cached            = choice.source.reused_tokens;
+            const auto handle = *choice.source.checkpoint;
+            // The consumed checkpoint's history becomes the running sequence; Host copies of
+            // its pages are restored and then dropped as redundant.
+            std::uint32_t carried = 0;
+            for (const auto& point : f.cache.points(choice.owner)) {
+                if (!f.program.valid_checkpoint(point)) { continue; }
+                auto& content = f.program.contents[point.index];
+                carried += content.main_pages;
+                content.main_pages = 0;
+            }
+            running = carried;
+            need_device(cached - carried);
+            require(f.program.release_checkpoint(handle), "consume failed");
+            const auto owner =
+                f.cache.adopt(f.program, choice, base, ++f.next_order, {}, {&handle, 1});
+            require(owner == d.owner, "continuation did not keep its owner");
+        } else {
+            running = 0;
+            d.owner = f.cache.adopt(f.program, choice, base, ++f.next_order);
+        }
+        need_device(prompt - cached);
+        d.prompt = prompt;
+        d.replay = capture(d.owner, base, prompt, running, Role::InputReplay);
+        running  = 0;
+        d.endpoint = capture(d.owner, base, prompt + 1, 0, Role::Continuation);
+        f.cache.finish(f.program, d.owner, base, f.next_order);
+        note(label, d, cached);
+        return cached;
+    }
+
+    void note(const char* label, const Convo& d, std::optional<std::uint32_t> cached = {}) {
+        if (!verbose) { return; }
+        std::cout << "  " << label << " prompt=" << d.prompt
+                  << (cached ? " cached=" + std::to_string(*cached) : std::string{})
+                  << " host=" << host_used() / 1e9 << "GB device=" << device_used()
+                  << " largest_hole=" << f.program.largest_hole() / 1e6 << "MB"
+                  << " reused=" << f.cache.retention(d.owner).reused
+                  << " dev_images=" << device_images()
+                  << " place_fails=" << f.program.placement_fails << "\n";
+    }
+
+};
+
+// Counter deltas when the build has them (fix and #239); empty on 81c8ce09.
+template <class C>
+std::string deltas(const C& before, const C& after) {
+    if constexpr (std::is_integral_v<C>) {
+        return "";
+    } else {
+        std::string out;
+        const auto add = [&](const char* name, std::uint64_t a, std::uint64_t b) {
+            out += std::string(" ") + name + "=" + std::to_string(b - a);
+        };
+        add("proven_admitted", before.proven_admitted, after.proven_admitted);
+        add("proven_demoted", before.proven_demoted, after.proven_demoted);
+        add("proven_downgraded", before.proven_downgraded, after.proven_downgraded);
+        add("proven_released", before.proven_released, after.proven_released);
+        add("release_deferred", before.release_deferred, after.release_deferred);
+        add("demanded_evicted", before.demanded_evicted, after.demanded_evicted);
+        add("proven_victimless", before.proven_victimless, after.proven_victimless);
+        add("newer_unprivileged", before.newer_unprivileged, after.newer_unprivileged);
+        add("proven_unrecorded", before.proven_unrecorded, after.proven_unrecorded);
+        if constexpr (requires { after.unplaceable_victims; }) {
+            add("unplaceable_victims", before.unplaceable_victims, after.unplaceable_victims);
+            add("demote_failed", before.demote_failed, after.demote_failed);
+            add("release_after_failed_demote", before.release_after_failed_demote,
+                after.release_after_failed_demote);
+        }
+        return out;
+    }
+}
+
+// Returns target3's cached pages (0 = lost).
+std::uint32_t host_admit(Replay& r, bool fill_to_threshold, const char* tag) {
+    const bool live_sizes = g_point.live_sizes;
+    // 2026-10-11 full run, pages of 64 tokens, rounded up
+    const std::uint32_t fill_pages[]  = {941, 939, 938, 941, 941, 941, 941, 941};
+    const std::uint32_t push1_pages[] = {1439, 1442, 1438, 1436};
+    const std::uint32_t push2_add[]   = {8, 8, 9, 9};
+    const auto fill_delta = g_point.fill_delta;
+    const auto push_delta = g_point.push_delta;
+    std::vector<Convo> fills;
+    int n = 0;
+    do {
+        const auto pages = (live_sizes && fill_to_threshold ? fill_pages[std::min(n, 7)] : kFill) + fill_delta;
+        fills.push_back(r.root(pages, ("fill" + std::to_string(++n)).c_str()));
+        if (r.verbose) { std::cout << "  " << tag << " fill " << n << ": host=" << r.host_used() / 1e9 << " GB\n"; }
+    } while (fill_to_threshold && r.host_used() < kCapacity * 9 / 10 && n < 40);
+    auto target = r.root(kTarget, "target1");
+    const auto t2 = r.continue_turn(target, kTargetAdd, "target2");
+    const auto sweep_all = [&](std::vector<Convo>& pushes) {
+        std::vector<Convo*> all{&target};
+        for (auto& p : pushes) { all.push_back(&p); }
+        for (auto& fl : fills) { all.push_back(&fl); }
+        r.sweep(all);
+    };
+    require(t2 >= kTarget, "target turn 2 was not cached from the Device");
+    const auto before = counters_of(r.f.cache);
+    std::vector<Convo> pushes;
+    for (int i = 0; i < 4; ++i) {
+        const auto p1 = (live_sizes && fill_to_threshold ? push1_pages[i] : kPush) + push_delta;
+        const auto p2 = live_sizes && fill_to_threshold ? push2_add[i] : kPushAdd;
+        pushes.push_back(r.root(p1, ("push" + std::to_string(i) + "1").c_str()));
+        sweep_all(pushes);
+        const auto cached =
+            r.continue_turn(pushes.back(), p2, ("push" + std::to_string(i) + "2").c_str());
+        require(cached >= p1, "push turn 2 was not cached");
+        sweep_all(pushes);
+    }
+    const auto after = counters_of(r.f.cache);
+    const bool replay_alive = target.replay && r.f.program.valid_checkpoint(*target.replay);
+    const auto cached       = r.continue_turn(target, kPushAdd, "target3");
+    std::cout << "  " << tag << ": target3 cached=" << cached << "/" << kTarget + kTargetAdd
+              << " placement_fails=" << r.f.program.placement_fails
+              << " skipped_captures=" << r.skipped_captures << " push-phase" << deltas(before, after)
+              << "\n";
+    return replay_alive ? cached : 0;
+}
+
+// The live day: an empty-tier run leaves residue, then the full-tier run.
+bool run_point(const Point& point) {
+    g_point = point;
+    std::cout << "point fill+" << point.fill_delta << " push+" << point.push_delta
+              << (point.live_sizes ? " live-sizes" : "") << " device_images=" << point.device_images
+              << "\n";
+    try {
+        Replay r;
+        const auto empty = host_admit(r, false, "empty");
+        const auto full  = host_admit(r, true, "full");
+        const bool pass  = empty && full;
+        std::cout << (pass ? "PASS" : "FAIL") << "\n";
+        return pass;
+    } catch (const std::exception& error) {
+        std::cout << "FAIL (" << error.what() << ")\n";
+        return false;
+    }
+}
+
+} // namespace
+
+// Default: 12 points (fill +0/+3/+4 pages, push +0/+10, both size sets) that include the
+// live counter signature. REPLAY_SWEEP=full runs all 156 (fill +0..5, push +0..12).
+int main() {
+    const bool full = std::getenv("REPLAY_SWEEP") && std::string(std::getenv("REPLAY_SWEEP")) == "full";
+    std::vector<Point> points;
+    for (const bool live : {false, true}) {
+        if (full) {
+            for (std::uint32_t fd = 0; fd <= 5; ++fd) {
+                for (std::uint32_t pd = 0; pd <= 12; ++pd) { points.push_back({fd, pd, live}); }
+            }
+        } else {
+            for (const std::uint32_t fd : {0U, 3U, 4U}) {
+                for (const std::uint32_t pd : {0U, 10U}) { points.push_back({fd, pd, live}); }
+            }
+        }
+    }
+    std::size_t failed = 0;
+    for (const auto& point : points) { failed += run_point(point) ? 0 : 1; }
+    std::cout << "replay: " << points.size() - failed << "/" << points.size() << " points kept the target\n";
+    return failed ? 1 : 0;
+}
