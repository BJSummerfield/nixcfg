@@ -0,0 +1,215 @@
+// Pause backup and demotion reservation policy against the real first-fit HostContextArena,
+// GPU-free: PinnedHostBuffer is replaced by an unreserved mapping, and nothing else from
+// ninfer_core is linked.
+#include "core/arena.h"
+#include "core/host_context_arena.h"
+#include "core/host_extent_runs.h"
+
+#include <sys/mman.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <optional>
+#include <random>
+#include <stdexcept>
+#include <vector>
+
+namespace ninfer {
+PinnedHostBuffer::PinnedHostBuffer(std::size_t size_bytes) {
+    void* ptr = mmap(nullptr, size_bytes, PROT_READ | PROT_WRITE,
+                     MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (ptr == MAP_FAILED) { throw std::runtime_error("mmap"); }
+    data_ = ptr;
+    size_ = size_bytes;
+}
+PinnedHostBuffer::~PinnedHostBuffer() {
+    if (data_) { munmap(data_, size_); }
+}
+void* PinnedHostBuffer::data() const noexcept { return data_; }
+std::size_t PinnedHostBuffer::size() const noexcept { return size_; }
+} // namespace ninfer
+
+namespace {
+using ninfer::HostContextAllocation;
+using ninfer::HostContextArena;
+
+constexpr std::size_t kCapacity     = 18'350'080'000ULL;
+constexpr std::size_t kState        = 153'954'304ULL;
+constexpr std::size_t kMain         = 2'113'536ULL;
+constexpr std::size_t kMtp          = 132'096ULL;
+constexpr std::uint32_t kPageTokens = 64;
+
+int failures = 0;
+void expect(bool ok, const char* what) {
+    std::printf("%s %s\n", ok ? "ok  " : "FAIL", what);
+    if (!ok) { ++failures; }
+}
+
+std::uint32_t pages_for(std::uint32_t tokens) { return (tokens + kPageTokens - 1) / kPageTokens; }
+
+std::vector<HostContextAllocation> write_entry(HostContextArena& arena, std::uint32_t tokens) {
+    std::vector<HostContextAllocation> parts;
+    const auto pages = pages_for(tokens);
+    for (const auto bytes : {kState, kMain * pages, kMtp * pages}) {
+        auto allocation = arena.allocate(bytes);
+        if (!allocation) { throw std::logic_error("fixture entry does not place"); }
+        parts.push_back(std::move(*allocation));
+    }
+    return parts;
+}
+
+// pause.cpp's collect for one address space, with the policy under test.
+std::optional<std::vector<HostContextAllocation>> backup(HostContextArena& arena, std::size_t pages,
+                                                         std::size_t stride, bool halving) {
+    std::vector<HostContextAllocation> runs;
+    if (!halving) {
+        auto run = arena.allocate(stride * pages);
+        if (!run) { return std::nullopt; }
+        runs.push_back(std::move(*run));
+        return runs;
+    }
+    const bool placed = ninfer::reserve_halving_runs(
+        pages, [&](std::size_t, std::size_t count) { return arena.allocate(stride * count); },
+        [&](std::size_t, std::size_t, HostContextAllocation run) { runs.push_back(std::move(run)); });
+    if (!placed) { return std::nullopt; }
+    return runs;
+}
+
+// Live 2026-10-11 pause: retained dialogues interleaved with released fills whose holes were
+// partly re-used by pressure spill, so free bytes cover the snapshot but no hole holds its
+// 2.23 GB main-KV run.
+void test_fragmented_full_tier_pause_backup() {
+    HostContextArena arena(kCapacity, kMtp);
+    std::vector<std::vector<HostContextAllocation>> kept;
+    kept.push_back(write_entry(arena, 92'160));
+    auto fill1 = write_entry(arena, 59'900);
+    kept.push_back(write_entry(arena, 76'900));
+    auto fill2 = write_entry(arena, 59'900);
+    kept.push_back(write_entry(arena, 30'500));
+    auto fill3 = write_entry(arena, 59'900);
+    kept.push_back(write_entry(arena, 92'160));
+    fill1.clear();
+    fill2.clear();
+    fill3.clear();
+    std::vector<HostContextAllocation> spill;
+    for (const std::size_t pages : {400, 700, 700}) {
+        auto run = arena.allocate(kMain * pages);
+        if (!run) { throw std::logic_error("fixture spill does not place"); }
+        spill.push_back(std::move(*run));
+    }
+    const auto pages = pages_for(67'584);
+    const auto need  = kState + (kMain + kMtp) * pages;
+    expect(arena.free_bytes() >= need, "free bytes cover the snapshot (no Host victims are taken)");
+    const auto occupied = arena.occupied_bytes();
+    expect(!backup(arena, pages, kMain, false).has_value(),
+           "81c8ce09 one-shot main-KV backup does not place (the live replay)");
+    expect(arena.occupied_bytes() == occupied, "a failed one-shot backup leaves the arena unchanged");
+    auto state = arena.allocate(kState);
+    auto main  = backup(arena, pages, kMain, true);
+    auto mtp   = backup(arena, pages, kMtp, true);
+    expect(state && main && mtp, "halving backup places the whole snapshot");
+    std::size_t bytes = 0;
+    for (const auto* runs : {&*main, &*mtp}) {
+        for (const auto& run : *runs) { bytes += run.bytes(); }
+    }
+    expect(main && mtp && bytes == (kMain + kMtp) * pages, "halving runs cover every page once");
+}
+
+// A Host with no hole of one page: the policy fails and its partial runs unwind.
+void test_unplaceable_backup_unwinds() {
+    HostContextArena arena(kMain * 8, kMtp);
+    std::vector<HostContextAllocation> halves;
+    for (int i = 0; i < 16; ++i) { halves.push_back(std::move(*arena.allocate(kMain / 2))); }
+    for (std::size_t i = 0; i < halves.size(); i += 2) { (void)halves[i].release(); }
+    const auto occupied = arena.occupied_bytes();
+    expect(arena.free_bytes() >= kMain * 2, "fixture leaves at least two pages free in bytes");
+    expect(!backup(arena, 2, kMain, true).has_value(), "no one-page hole: backup fails");
+    expect(arena.occupied_bytes() == occupied, "a failed halving backup unwinds every run");
+}
+
+// The helper is the demotion's own loop (reclaim.cpp start_demote): same runs on random arenas.
+void test_matches_demotion_loop() {
+    std::mt19937 random(20261011);
+    bool same = true;
+    for (int trial = 0; trial < 200 && same; ++trial) {
+        const std::size_t page = 16;
+        HostContextArena a(page * 256, 1), b(page * 256, 1);
+        std::vector<HostContextAllocation> keep_a, keep_b;
+        for (int i = 0; i < 40; ++i) {
+            const auto bytes = (random() % 24 + 1) * 4;
+            const bool keep  = random() % 3 != 0;
+            auto x           = a.allocate(bytes);
+            auto y           = b.allocate(bytes);
+            if (!x || !y) { break; }
+            if (keep) {
+                keep_a.push_back(std::move(*x));
+                keep_b.push_back(std::move(*y));
+            }
+        }
+        const std::size_t pages = random() % 40 + 1;
+        std::vector<std::pair<std::size_t, std::size_t>> mine, theirs;
+        std::vector<HostContextAllocation> held_a, held_b;
+        const bool ok_mine = ninfer::reserve_halving_runs(
+            pages, [&](std::size_t, std::size_t count) { return a.allocate(page * count); },
+            [&](std::size_t offset, std::size_t count, HostContextAllocation run) {
+                mine.emplace_back(offset, count);
+                held_a.push_back(std::move(run));
+            });
+        bool ok_theirs     = true;
+        std::size_t offset = 0;
+        while (offset < pages) {
+            auto count = pages - offset;
+            std::optional<HostContextAllocation> destination;
+            while (count) {
+                auto reservation = b.allocate(page * count);
+                if (reservation) {
+                    destination.emplace(std::move(*reservation));
+                    break;
+                }
+                count /= 2;
+            }
+            if (!destination) {
+                ok_theirs = false;
+                break;
+            }
+            theirs.emplace_back(offset, count);
+            held_b.push_back(std::move(*destination));
+            offset += count;
+        }
+        same = ok_mine == ok_theirs && mine == theirs;
+    }
+    expect(same, "reserve_halving_runs reserves exactly the runs start_demote's loop does");
+}
+// can_place_runs predicts exactly what the halving reservation then does, without mutating.
+void test_can_place_runs_predicts_reservation() {
+    std::mt19937 random(378);
+    bool agrees = true;
+    for (int trial = 0; trial < 500 && agrees; ++trial) {
+        const std::size_t page = 16;
+        HostContextArena arena(page * 256, 1);
+        std::vector<HostContextAllocation> kept;
+        for (int i = 0; i < 40; ++i) {
+            const auto bytes = (random() % 24 + 1) * 4;
+            const bool keep  = random() % 3 != 0;
+            auto allocation  = arena.allocate(bytes);
+            if (!allocation) { break; }
+            if (keep) { kept.push_back(std::move(*allocation)); }
+        }
+        const std::size_t pages = random() % 40 + 1;
+        const auto occupied     = arena.occupied_bytes();
+        const bool predicted    = arena.can_place_runs(page, pages);
+        agrees = arena.occupied_bytes() == occupied &&
+                 predicted == backup(arena, pages, page, true).has_value();
+    }
+    expect(agrees, "can_place_runs agrees with the halving reservation on 500 random arenas");
+}
+
+} // namespace
+
+int main() {
+    test_can_place_runs_predicts_reservation();
+    test_fragmented_full_tier_pause_backup();
+    test_unplaceable_backup_unwinds();
+    test_matches_demotion_loop();
+    return failures ? 1 : 0;
+}
