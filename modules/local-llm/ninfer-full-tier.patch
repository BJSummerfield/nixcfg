+// #378 at the Host ceiling: free bytes exceed the KV write, yet no run of holes places its
+// pages (start_demote halves the extent down to one page and still finds no hole). The
+// victimless demotion must not fall through to deleting the proven dialogue; it spends a
+// cold Host victim and moves on the next pass.
+void test_unplaceable_kv_demotion_spends_a_cold_victim_instead_of_the_proven_dialogue() {
+    Fixture f(100);
+    f.program.contiguous = true;
+    // Page = 10 bytes. Live Host: cold fill [0,40), pinned [55,68) and [85,100).
+    // Holes: [40,55) = 15 and [68,85) = 17: 32 free bytes for a 30-byte write, but the
+    // halving tiling places only 1 + 1 pages.
+    const auto cold = host_only(f, 60, 90000, 40);
+    f.program.blocks.push_back({13, true, 55});
+    f.program.blocks.push_back({15, true, 85});
+    const auto target = continued_once(f, 30, 38, 44, 50000, 3);
+    f.program.contents[target.replay.index].demotion_bytes = 10;
+    require(f.cache.retention(target.owner).reused, "fixture target is not reused");
+    require(f.program.physical_usage().occupied.host_bytes == 68 &&
+                !f.program.host_hole(30).has_value(),
+            "fixture Host is not at the fragmented ceiling");
+    for (int i = 0; i < 4 && f.program.valid_checkpoint(target.replay) &&
+                    f.program.contents[target.replay.index].main_pages;
+         ++i) {
+        (void)f.cache.reclaim(f.program, {.main_kv_pages = 3});
+    }
+    require(f.program.valid_checkpoint(target.replay) && demoted(f, target.replay) &&
+                f.program.contents[target.replay.index].main_pages == 0 &&
+                !f.program.valid_checkpoint(cold),
+            "an unplaceable victimless KV demotion deleted the proven dialogue instead of "
+            "spending the cold Host victim");
+}
+
+// #378 on the capture path (Device state slots full, so the capture writes its image straight
+// to the Host): free bytes cover the image but no hole fits it. The engine marks the write
+// unplaceable, so the capture takes a cold victim for its whole size instead of being skipped.
+template <class Cache, class Admission, class Cursor>
+std::optional<std::vector<Handle>> capture_victims(Cache& cache, Program& program,
+                                                   std::size_t bytes, const Admission& admission,
+                                                   Cursor& cursor) {
+    const bool unplaceable = !program.host_hole(bytes).has_value();
+    if constexpr (requires {
+                      cache.host_victims(program, bytes, std::nullopt, std::span<const Handle>{},
+                                         std::span<const Handle>{}, admission, &cursor,
+                                         decltype(cursor.rights){}, true);
+                  }) {
+        return cache.host_victims(program, bytes, std::nullopt, {}, {}, admission, &cursor, {},
+                                  unplaceable);
+    } else {
+        return cache.host_victims(program, bytes, std::nullopt, {}, {}, admission, &cursor);
+    }
+}
+
+void test_unplaceable_capture_image_spends_a_cold_victim_instead_of_being_skipped() {
+    Fixture f(100);
+    // Live Host: cold fill [0,40), pinned [55,68) and [85,100). 32 bytes free in holes of 15
+    // and 17, but the 30-byte image needs one hole.
+    const auto cold = host_only(f, 60, 90000, 40);
+    f.program.blocks.push_back({13, true, 55});
+    f.program.blocks.push_back({15, true, 85});
+    require(!f.program.host_hole(30).has_value() &&
+                f.program.physical_usage().occupied.host_bytes == 68,
+            "fixture Host is not at the fragmented ceiling");
+    const Base incoming{.tokens = tokens(90, 60000), .captures = {90}};
+    const auto admission = f.cache.capture_admission(f.program, 0, incoming, 90, true);
+    auto cursor          = f.cache.begin_reclaim(f.program, admission);
+    const auto victims   = capture_victims(f.cache, f.program, 30, admission, cursor);
+    if (victims && !victims->empty()) { f.cache.commit_host_victims(f.program, *victims, cursor); }
+    require(victims && std::ranges::find(*victims, cold) != victims->end() &&
+                f.program.host_hole(30).has_value(),
+            "an unplaceable capture image found no victims although a cold one would make room");
+}
