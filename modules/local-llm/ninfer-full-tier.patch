+bool ProgramImpl::host_placeable(const ContextDemotion& quote) const {
+    if (!quote.host_bytes || !quote.impl) { return true; }
+    if (!host_context_arena) { return false; }
+    const auto& plan = *quote.impl;
+    if (plan.state) {
+        return plan.state->host_resident ||
+               host_context_arena->can_allocate(state_images->host_layout().image_bytes);
+    }
+    std::size_t missing = 0;
+    for (const auto& page : plan.pages) { missing += page.host_resident ? 0U : 1U; }
+    const auto stride = plan.resource == runtime::ContextResourceClass::MainKV
+                            ? text_host_kv_page_stride
+                            : backend_host_kv_page_stride;
+    return host_context_arena->can_place_runs(stride, missing);
+}
+
+bool ProgramImpl::host_placeable_bytes(std::size_t bytes) const {
+    return host_context_arena && host_context_arena->can_allocate(bytes);
+}
+
