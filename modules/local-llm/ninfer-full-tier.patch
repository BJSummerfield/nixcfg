diff --git a/src/core/host_extent_runs.h b/src/core/host_extent_runs.h
new file mode 100644
index 0000000..a82788a
--- /dev/null
+++ b/src/core/host_extent_runs.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <cstddef>
+#include <utility>
+
+namespace ninfer {
+
+// Reserves `total` consecutive items as runs, each the longest prefix of the remainder that
+// `prepare(offset, count)` places, halving the count on failure. `emit(offset, count, reservation)`
+// receives each run in order. Returns false when not even one item places; runs already
+// emitted stay with the caller, who unwinds them.
+template <class Prepare, class Emit>
+bool reserve_halving_runs(std::size_t total, Prepare&& prepare, Emit&& emit) {
+    std::size_t offset = 0;
+    while (offset < total) {
+        auto count  = total - offset;
+        bool placed = false;
+        while (count && !placed) {
+            if (auto reservation = prepare(offset, count)) {
+                emit(offset, count, std::move(*reservation));
+                placed = true;
+            } else {
+                count /= 2;
+            }
+        }
+        if (!placed) { return false; }
+        offset += count;
+    }
+    return true;
+}
+
+} // namespace ninfer
