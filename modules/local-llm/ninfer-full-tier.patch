+bool HostContextArena::can_place_runs(std::size_t stride, std::size_t count) const {
+    auto free = free_extents_;
+    return reserve_halving_runs(
+        count,
+        [&](std::size_t, std::size_t n) -> std::optional<std::pair<std::size_t, std::size_t>> {
+            const std::size_t rounded =
+                stride && n <= std::numeric_limits<std::size_t>::max() / stride
+                    ? allocation_bytes(stride * n)
+                    : 0;
+            if (rounded == 0) { return std::nullopt; }
+            for (std::size_t index = 0; index < free.size(); ++index) {
+                if (free[index].bytes >= rounded) { return std::pair{index, rounded}; }
+            }
+            return std::nullopt;
+        },
+        [&](std::size_t, std::size_t, std::pair<std::size_t, std::size_t> taken) {
+            auto& extent = free[taken.first];
+            extent.offset += taken.second;
+            extent.bytes -= taken.second;
+            if (extent.bytes == 0) {
+                free.erase(free.begin() + static_cast<std::ptrdiff_t>(taken.first));
+            }
+        });
+}
+
 std::optional<HostContextAllocation> HostContextArena::allocate(std::size_t bytes) noexcept {
     const std::size_t rounded = allocation_bytes(bytes);
     if (rounded == 0) { return std::nullopt; }
