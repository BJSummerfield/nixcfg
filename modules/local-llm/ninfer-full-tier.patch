+Handle host_only(Fixture& f, std::uint32_t count, std::uint32_t first, std::size_t bytes = 32) {
+    const auto handle = f.program.add(tokens(count, first), {f.program.host_block(bytes)},
+                                      Role::Continuation);
+    f.program.contents[handle.index].device_state = false;
+    f.program.contents[handle.index].main_pages   = 0;
+    f.publish(handle);
+    return handle;
+}
+
+bool demoted(const Fixture& f, Handle handle) {
+    return std::find(f.program.demoted.begin(), f.program.demoted.end(), handle) !=
+           f.program.demoted.end();
+}
