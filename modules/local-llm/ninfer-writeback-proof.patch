+            const auto* owner = find_owner(proof.owner);
+            if (!owner) { continue; }
+            std::optional<Handle> holder;
+            bool covered = true;
+            for (const auto handle : proof.points) {
+                if (!contains(sources, handle) || !program.valid_checkpoint(handle)) { continue; }
+                const auto frontier = program.checkpoint_metadata(handle).frontier;
+                if (frontier < proof.proven_frontier) { continue; }
+                if (!holder) { holder = handle; }
+                bool fallback = false;
+                for (const auto& point : owner->points) {
+                    if (contains(sources, point.handle) || !program.valid_checkpoint(point.handle)) {
+                        continue;
+                    }
+                    const auto candidate = program.checkpoint_metadata(point.handle).frontier;
+                    if (candidate < proof.proven_frontier || candidate > frontier) { continue; }
+                    if (recovery_loss(program, {&handle, 1}, {&point.handle, 1}, evaluation) ==
+                        frontier - candidate) {
+                        fallback = true;
+                        break;
+                    }
+                }
+                covered = covered && fallback;
+            }
+            if (!holder || covered) { continue; }
+            const auto demand =
+                demand_priority(program.checkpoint_key(*holder, proof.proven_frontier));
+            if (!demand.reused) {
+                if (unrecorded) { *unrecorded = true; }
+                continue;
+            }
+            if (!result.reused || demand.last_demand > result.last_demand) { result = demand; }
+        }
+        return result;
+    }
