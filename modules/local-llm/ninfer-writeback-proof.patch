+
+using Progress = ninfer::runtime::ReclaimProgress;
+
+struct Dialogue {
+    Fixture::Token owner;
+    Handle replay;
+    Handle endpoint;
+};
+
+// Turn 1 publishes E@turn1 (consumed by turn 2); turn 2 publishes R@input and E@end.
+// The adopt-time demand record therefore sits at turn1, a position with no checkpoint.
+Dialogue continued_once(Fixture& f, std::uint32_t turn1, std::uint32_t input, std::uint32_t end,
+                        std::uint32_t first, std::uint32_t replay_pages = 1) {
+    const auto predecessor = f.program.add(tokens(turn1, first), {}, Role::Continuation);
+    const auto owner       = f.publish(predecessor);
+    const Base next{.tokens = tokens(end, first)};
+    auto choice = f.source(next, predecessor);
+    require(choice.take_over && choice.source.consume_source, "turn 2 did not take over turn 1");
+    require(f.program.release_checkpoint(predecessor), "fixture consume failed");
+    require(f.cache.adopt(f.program, choice, next, ++f.next_order, {}, {&predecessor, 1}) == owner,
+            "turn 2 did not continue its owner");
+    const auto replay   = f.program.add(tokens(input, first), {}, Role::InputReplay);
+    const auto endpoint = f.program.add(tokens(end, first), {}, Role::Continuation);
+    f.program.contents[replay.index].main_pages     = replay_pages;
+    f.program.contents[replay.index].demotion_bytes = 32;
+    f.cache.publish(f.program, owner, replay);
+    f.cache.publish(f.program, owner, endpoint);
+    f.cache.finish(f.program, owner, next, f.next_order);
+    return {owner, replay, endpoint};
+}
+
+Handle host_only(Fixture& f, std::uint32_t count, std::uint32_t first, std::size_t bytes = 32) {
+    const auto handle = f.program.add(tokens(count, first), {f.program.host_block(bytes)},
+                                      Role::Continuation);
+    f.program.contents[handle.index].device_state = false;
+    f.program.contents[handle.index].main_pages   = 0;
+    f.publish(handle);
+    return handle;
+}
+
+bool demoted(const Fixture& f, Handle handle) {
+    return std::find(f.program.demoted.begin(), f.program.demoted.end(), handle) !=
+           f.program.demoted.end();
+}
+
+void test_full_host_moves_a_continued_dialogue_over_longer_single_use_history() {
+    Fixture f(128);
+    std::vector<Handle> fills;
+    for (std::uint32_t i = 0; i < 4; ++i) { fills.push_back(host_only(f, 60, 1000 * (i + 1))); }
+    const auto target = continued_once(f, 30, 38, 44, 50000);
+    require(f.cache.retention(target.owner).reused, "fixture target is not reused");
+    for (int i = 0; i < 8 && f.program.valid_checkpoint(target.replay) &&
+                    !demoted(f, target.replay);
+         ++i) {
+        (void)f.cache.reclaim(f.program, {.state_slots = 1});
+    }
+    const auto lost = std::count_if(fills.begin(), fills.end(),
+                                    [&](auto h) { return !f.program.valid_checkpoint(h); });
+    require(f.program.valid_checkpoint(target.replay) && demoted(f, target.replay) && lost == 1,
+            "a full Host deleted a continued dialogue instead of one single-use history");
+}
+
+void test_downgraded_continued_dialogue_is_moved_not_deleted() {
+    Fixture f(128);
+    f.program.main_capacity = 40;
+    std::vector<Handle> fills;
+    for (std::uint32_t i = 0; i < 4; ++i) { fills.push_back(host_only(f, 60, 1000 * (i + 1))); }
+    const auto target = continued_once(f, 30, 38, 44, 50000, 8);
+    const auto push0  = continued_once(f, 90, 92, 94, 60000, 12);
+    const auto push1  = continued_once(f, 90, 92, 94, 70000, 12);
+    require(!f.cache.retention(target.owner).reused && f.cache.retention(push1.owner).reused,
+            "fixture did not downgrade the oldest reused dialogue");
+    for (int i = 0; i < 8 && f.program.valid_checkpoint(target.replay) &&
+                    !demoted(f, target.replay);
+         ++i) {
+        (void)f.cache.reclaim(f.program, {.state_slots = 1});
+    }
+    const auto lost = std::count_if(fills.begin(), fills.end(),
+                                    [&](auto h) { return !f.program.valid_checkpoint(h); });
+    require(f.program.valid_checkpoint(target.replay) && demoted(f, target.replay) && lost == 1 &&
+                f.program.valid_checkpoint(push0.replay) &&
+                f.program.valid_checkpoint(push1.replay),
+            "a downgraded continued dialogue was deleted although a cold Host victim existed");
+}
+
+void test_moved_dialogue_cannot_displace_a_more_recently_demanded_one() {
+    Fixture f(64);
+    f.program.main_capacity = 40;
+    const auto oldest = continued_once(f, 30, 38, 44, 40000, 8);
+    const auto older  = continued_once(f, 30, 38, 44, 50000, 8);
+    const auto newer  = continued_once(f, 20, 22, 24, 60000, 8);
+    for (const std::uint32_t first : {70000U, 80000U}) {
+        const auto push = continued_once(f, 90, 92, 94, first, 12);
+        f.program.contents[push.replay.index].demotion_bytes.reset();
+    }
+    require(!f.cache.retention(oldest.owner).reused && !f.cache.retention(older.owner).reused &&
+                !f.cache.retention(newer.owner).reused,
+            "fixture did not downgrade all three dialogues");
+    require(f.cache.erase(f.program, newer.endpoint), "fixture could not drop newer suffix");
+    auto& moved        = f.program.contents[newer.replay.index];
+    moved.device_state = false;
+    moved.main_pages   = 0;
+    moved.host_blocks.push_back(f.program.host_block(32));
+    const auto cold = host_only(f, 60, 90000);
+    f.program.contents[oldest.replay.index].device_state = false;
+    for (int i = 0; i < 8 && f.program.valid_checkpoint(older.replay) && !demoted(f, older.replay);
+         ++i) {
+        (void)f.cache.reclaim(f.program, {.state_slots = 1});
+    }
+    require(demoted(f, older.replay) && !f.program.valid_checkpoint(cold) &&
+                f.program.valid_checkpoint(newer.replay),
+            "a write-back displaced a more recently demanded dialogue instead of cold history");
+    f.program.contents[oldest.replay.index].device_state = true;
+    for (int i = 0; i < 8 && f.program.valid_checkpoint(oldest.replay) &&
+                    !demoted(f, oldest.replay);
+         ++i) {
+        (void)f.cache.reclaim(f.program, {.state_slots = 1});
+    }
+    require(f.program.valid_checkpoint(older.replay) && !f.program.valid_checkpoint(newer.replay) &&
+                demoted(f, oldest.replay),
+            "a write-back did not displace newer-demand content it out-recovers");
+    const auto kept_oldest = f.program.valid_checkpoint(oldest.replay);
+    for (int i = 0; i < 6; ++i) { (void)f.cache.reclaim(f.program, {.state_slots = 1}); }
+    require(f.program.valid_checkpoint(older.replay) &&
+                f.program.valid_checkpoint(oldest.replay) == kept_oldest,
+            "Host residents kept displacing each other without new demand");
+}
+
+void test_newer_writeback_evicts_cold_history_before_an_older_demanded_dialogue() {
+    Fixture f(64);
+    f.program.main_capacity = 40;
+    const auto older = continued_once(f, 30, 38, 44, 50000, 8);
+    for (const std::uint32_t first : {70000U, 80000U}) {
+        const auto push = continued_once(f, 90, 92, 94, first, 12);
+        f.program.contents[push.replay.index].demotion_bytes.reset();
+    }
+    require(!f.cache.retention(older.owner).reused, "fixture did not downgrade the older dialogue");
+    require(f.cache.erase(f.program, older.endpoint), "fixture could not drop older suffix");
+    auto& moved        = f.program.contents[older.replay.index];
+    moved.device_state = false;
+    moved.main_pages   = 0;
+    moved.host_blocks.push_back(f.program.host_block(32));
+    const auto cold  = host_only(f, 60, 90000);
+    const auto newer = continued_once(f, 40, 48, 50, 60000, 8);
+    for (int i = 0; i < 8 && f.program.valid_checkpoint(newer.replay) && !demoted(f, newer.replay);
+         ++i) {
+        (void)f.cache.reclaim(f.program, {.state_slots = 1});
+    }
+    require(demoted(f, newer.replay) && !f.program.valid_checkpoint(cold) &&
+                f.program.valid_checkpoint(older.replay),
+            "a newer write-back evicted an older demanded dialogue before cold history");
+}
